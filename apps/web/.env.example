# All NEXT_PUBLIC_* values are, by definition, shipped to the browser.
# Never put a private key or any other secret in this file or in any
# NEXT_PUBLIC_* variable — the browser wallet (Freighter) is always the
# signing authority; this app never holds a key of its own.

NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
NEXT_PUBLIC_STELLAR_NETWORK=TESTNET
NEXT_PUBLIC_STELLAR_RPC_URL=https://soroban-testnet.stellar.org
NEXT_PUBLIC_STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
NEXT_PUBLIC_PROVIDER_REGISTRY_CONTRACT_ID=
NEXT_PUBLIC_CARE_AGREEMENT_CONTRACT_ID=
NEXT_PUBLIC_SETTLEMENT_ASSET_CONTRACT_ID=
